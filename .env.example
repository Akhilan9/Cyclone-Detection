# Environment Configuration Template
# Tropical Cyclone AI/ML Framework

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="Tropical Cyclone AI Framework"
API_V1_STR=/api/v1
PROJECT_NAME="A Deep Learning Framework for Multi-Source Satellite-Based Tropical Cyclone Detection, Classification, and Prediction"

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration
# For local dev without Postgres service running, use SQLite fallback:
# DATABASE_URL=sqlite:///./cyclone_dev.db
# For production PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyclone_db
TEST_DATABASE_URL=sqlite:///./cyclone_test.db

# Machine Learning Artifacts Path
ML_MODELS_DIR=ml/artifacts
ML_DATA_DIR=data

# Satellite & Data Ingestion
NOAA_IBTRACS_URL=https://www.ncei.noaa.gov/data/international-best-track-archive-for-climate-stewardship-ibtracs/v04r01/access/csv/ibtracs.NI.list.v04r01.csv
MAX_UPLOAD_SIZE_MB=25

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
